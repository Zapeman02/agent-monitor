#!/usr/bin/env python3
"""Agent Monitor launcher: make sure our server runs, mint a one-time login nonce, open the app window.
The long-lived token is only read from the 0600 token file and sent in a header; never in argv/URLs/logs.
Env: AM_PORT (7777), AM_CONFIG_DIR, AM_STATE_DIR, AM_REPO, AM_APP. Flags: --print-url (don't open a window); --stop (stop the server we started, and with it its claude sessions)."""
import http.client, json, os, shutil, signal, socket, subprocess, sys, time

REPO = ""  # install.sh writes the repo path here; empty = parent of this script's dir
HOME = os.path.expanduser("~")
PORT = int(os.environ.get("AM_PORT", 7777))
CFG = os.environ.get("AM_CONFIG_DIR") or f"{HOME}/.config/agent-monitor"
STATE = os.environ.get("AM_STATE_DIR") or f"{HOME}/.local/state/agent-monitor"
PIDFILE = f"{STATE}/server.pid"
APP = os.environ.get("AM_APP") or f"{HOME}/Applications/Agent Monitor.app"


def listening():
    try:
        socket.create_connection(("127.0.0.1", PORT), 0.5).close()
        return True
    except OSError:
        return False


def lsof(*fields):
    """lsof lines for the 127.0.0.1:PORT LISTEN socket. Without root, lsof only sees our own uid's sockets."""
    cmd = [os.environ.get("AM_LSOF", "lsof"), "-nP", f"-iTCP@127.0.0.1:{PORT}", "-sTCP:LISTEN", *fields]
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=5).stdout.splitlines()
    except (OSError, subprocess.TimeoutExpired):
        return []


def ours():
    """True if the 127.0.0.1:PORT LISTEN socket belongs to our uid (checked before the token is sent)."""
    return any(l == f"u{os.getuid()}" for l in lsof("-Fu"))


def get_nonce():
    """Nonce if OUR server answers with the current token file, else None."""
    try:
        tok = open(f"{CFG}/token").read().strip()
        c = http.client.HTTPConnection("127.0.0.1", PORT, timeout=3)
        c.request("POST", "/api/once", "{}", {"X-AM-Token": tok, "Content-Type": "application/json"})
        r = c.getresponse()
        body = r.read()
        return json.loads(body)["once"] if r.status == 200 else None
    except (OSError, ValueError, KeyError):
        return None


def fail(msg):
    print(msg, file=sys.stderr)
    if shutil.which("osascript"):
        subprocess.run(["osascript", "-e", f"display notification {json.dumps(msg)} with title \"Agent Monitor\""], check=False)
    sys.exit(1)


def busy_pid():
    pids = lsof("-t")
    return pids[0] if pids else "unknown"


# A Finder/Spotlight launch only has /usr/bin:/bin:/usr/sbin:/sbin; spawned `claude` lives in one of these.
PATH = os.pathsep.join([f"{HOME}/.local/bin", "/opt/homebrew/bin", "/usr/local/bin", os.environ.get("PATH", "/usr/bin:/bin")])


def start_server():
    repo = os.environ.get("AM_REPO") or REPO or os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
    os.makedirs(STATE, exist_ok=True)
    log = open(f"{STATE}/server.log", "ab")
    p = subprocess.Popen([sys.executable, f"{repo}/server.py"], cwd=repo, stdin=subprocess.DEVNULL, stdout=log, stderr=log,
                         start_new_session=True, env={**os.environ, "PORT": str(PORT), "AM_CONFIG_DIR": CFG, "PATH": PATH})
    with open(PIDFILE, "w") as f:
        f.write(str(p.pid))


def stop():
    """SIGTERM the server from PIDFILE; its atexit handler closes the claude sessions."""
    try:
        pid = int(open(PIDFILE).read())
        os.remove(PIDFILE)
    except (OSError, ValueError):
        return
    cmd = subprocess.run(["ps", "-p", str(pid), "-o", "command="], capture_output=True, text=True).stdout
    if "server.py" in cmd:  # the pid may have been reused since
        os.kill(pid, signal.SIGTERM)


def main():
    if listening() and not ours():
        fail(f"port {PORT} is in use by another user's process (pid {busy_pid()}) — token not sent; stop it or set AM_PORT")
    nonce = get_nonce() if listening() else None
    if nonce is None and listening():
        time.sleep(1)  # maybe our server is mid-restart and rewriting the token
        nonce = get_nonce()
        if nonce is None:
            fail(f"port {PORT} is in use by another process (pid {busy_pid()}) — stop it or set AM_PORT")
    if nonce is None:
        start_server()
        end = time.monotonic() + 10
        while nonce is None and time.monotonic() < end:
            time.sleep(0.25)
            nonce = get_nonce() if listening() else None
        if nonce is None:
            fail(f"server did not respond on port {PORT} within 10 s (log: {STATE}/server.log)")
    url = f"http://127.0.0.1:{PORT}/login?once={nonce}&to=brain"
    if "--print-url" in sys.argv:
        print(url)
        return
    if not os.path.isdir(APP):
        fail(f"{APP} not found; run packaging/install.sh")
    # the app is single-instance: a running window gets the new login URL and comes to the front
    subprocess.Popen([f"{APP}/Contents/MacOS/AgentMonitor", url],
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


if "--stop" in sys.argv:
    stop()
else:
    main()
