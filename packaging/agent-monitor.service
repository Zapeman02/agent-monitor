[Unit]
Description=Agent Monitor v2 (local server, 127.0.0.1)

[Service]
# install.sh replaces @REPO@ with the repo path.
ExecStart=/usr/bin/python3 @REPO@/server.py
WorkingDirectory=@REPO@
Environment=PORT=7777
# real claude binary before ~/.local/bin (which may hold a mise wrapper that re-installs on every call)
Environment=PATH=%h/.local/share/mise/installs/claude/latest:%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin
Restart=on-failure
RestartSec=2
# Children are claude sessions: they must die with the service.
KillMode=control-group
# Deliberately NO ProtectHome/PrivateTmp/NoNewPrivileges/ProtectSystem etc.: spawned `claude`
# needs the user's full harness (~/.claude, tools, git, ssh, mise) and normal process privileges.

[Install]
WantedBy=default.target
